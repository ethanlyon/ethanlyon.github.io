---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Ethan [Nelson] Lyon — Senior Data Scientist' } = Astro.props;
const nav = [
  { href: '/', label: 'home' },
  { href: '/work', label: 'work' },
  { href: '/resume', label: 'resume' },
  { href: '/thoughts', label: 'thoughts' },
  { href: '/contact', label: 'contact' },
];
const pathname = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body style="background:var(--bg);color:var(--text);font-family:'Space Mono',monospace;">
    <header style="border-bottom:1px solid var(--border);padding:1.25rem 2rem;display:flex;align-items:center;justify-content:space-between;">
      <a href="/" style="font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:var(--accent);font-weight:700;">
        Ethan [Nelson] Lyon
      </a>
      <nav style="display:flex;gap:2rem;">
        {nav.map(({ href, label }) => {
          const active = pathname === href;
          return (
            <a
              href={href}
              style={`font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:${active ? 'var(--accent)' : 'var(--muted)'};transition:color 0.2s;`}
            >
              {active ? `> ${label}` : label}
            </a>
          );
        })}
      </nav>
    </header>

    <main style="max-width:800px;margin:0 auto;padding:4rem 2rem;">
      <slot />
    </main>

    <footer style="border-top:1px solid var(--border);padding:1.25rem 2rem;text-align:center;font-size:11px;letter-spacing:0.1em;color:var(--muted);">
      © {new Date().getFullYear()} — Ethan Nelson Lyon
    </footer>
  </body>
</html>
